@{
}

@model ResetPasswordViewModel
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <strong>Error</strong>
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
<form method="post" action="/User/ResetPassword">
    <div class="container mt-5 d-flex justify-content-center">
        <div class="card p-4 shadow-lg" style="max-width: 600px; width: 100%;">
            <div class="card-body">
                <div style="text-align:center">
                    <h2>Reset password</h2>
                </div>

                <input type="hidden" name="token" value="@Model.Token" />
                <input type="hidden" name="email" value="@Model.Email" />

                <div class="row mb-3">
                    <div class="col-12">
                        <input type="password" class="form-control" name="Password" placeholder="New password" required>
                        <p style="color:red">Password must contain at least 6 characters and have at least 1 digit</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <input type="password" class="form-control" name="ConfirmedPassword" placeholder="Confirm password" required>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12 text-center">
                        <button class="btn btn-primary" type="submit">Reset password</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
