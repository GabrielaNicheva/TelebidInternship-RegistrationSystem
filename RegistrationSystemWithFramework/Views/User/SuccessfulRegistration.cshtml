@{
}
<style>
    .button-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        align-items: center;
        height: 50vh;
    }

    .btn {
        padding: 15px 30px;
        font-size: 18px;
    }

</style>
<div class="text-center">
    <h1>Successful registration</h1>
</div>
@if (ViewContext.HttpContext.Session.GetString("UserEmail") is null)
{
    <div class="button-container">
        <a class="btn btn-primary" asp-area="" asp-controller="User" asp-action="Login">Login</a>
    </div>
}
