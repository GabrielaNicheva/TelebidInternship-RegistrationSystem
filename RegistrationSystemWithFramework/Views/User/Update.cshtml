@{
}
@using RegistrationSystemWithFramework.Models

@model UserUpdateViewModel

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <strong>There was an error during the registration:</strong>
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
} 

<form method="post" action="/User/Update">
    <div class="container mt-5 d-flex justify-content-center">
        <div class="card p-4 shadow-lg" style="max-width: 600px; width: 100%;">
            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-12">
                        <p>Name:</p>
                        <input type="name" class="form-control" name="Name" value="@Model.Name">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <p>Password:</p>
                        <input class="form-control" name="Password" value="@Model.Password">
                        <p style="color:red">Password must be at least 6 characters long and must contain at least 1 digit</p>
                    </div>
                </div>
                <input type="hidden" name="Email" value="@Model.Email" />

                <div class="row mb-3">
                    <div class="col-12 text-center">
                        <button class="btn btn-primary" type="submit">Update</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
    </div>
</form>