@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger">
        <strong>There was an error during the registration:</strong>
          <div class="validation-summary-errors">
              @Html.Raw(ViewBag.ErrorMessage)
          </div>
    </div>
}
<form method="post" action="/User/Registration">
    <div class="container mt-5 d-flex justify-content-center">
        <div class="card p-4 shadow-lg" style="max-width: 600px; width: 100%;">
            <div class="card-body">
                <div style="text-align:center">
                    <h2>Registration</h2>
                </div>
                <div class="row mb-3">
                    <div class="col-12">
                        <input type="text" class="form-control" name="Name" placeholder="Name" required>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <input type="email" class="form-control" name="Email" placeholder="Email" required>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-4">
                        <select class="form-select" id="phoneIso" name="ISOCode" aria-label="Country code" required>
                            <option selected>Choose...</option>
                            <option value="+1">+1 (USA)</option>
                            <option value="+44">+44 (UK)</option>
                            <option value="+49">+49 (Germany)</option>
                            <option value="+359">+359 (Bulgaria)</option>
                            <option value="+33">+33 (France)</option>
                            <option value="+34">+34 (Spain)</option>
                            <option value="+39">+39 (Italy)</option>
                        </select>
                    </div>
                    <div class="col-8">
                        <input type="tel" class="form-control" name="Phone" placeholder="Phone number" required>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <select class="form-select" name="Gender" id="gender">
                            <option value="" selected disabled>Choose your gender</option>
                            <option value="male">Male</option>
                            <option value="female">Female</option>
                            <option value="unknown">I prefer not to say</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <input type="text" class="form-control" name="Address" placeholder="Address">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <input type="password" class="form-control" name="Password" placeholder="Password" required>
                        <p style="color:red">Password must contain at least 6 characters and have at least 1 digit</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12">
                        <input type="password" class="form-control" name="ConfirmedPassword" placeholder="Confirm Password" required>
                    </div>
                </div>
				<img src="@Url.Action("GenerateCaptchaImage", "User")" alt="CAPTCHA" />
				<div class="row mb-3">
					<div class="col-12">
						<input type="text" class="form-control" name="Captcha" placeholder="Captcha">
					</div>
				</div>
				<br />
                <div class="row mb-3">
                    <div class="col-12 text-center">
                        <button class="btn btn-primary" type="submit">Register</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    function refreshCaptcha() {
        document.getElementById('captchaImage').src = '@Url.Action("GenerateCaptchaImage", "User")?' + new Date().getTime();
    }
</script>